# RC car hotspot credentials — the WiFi network the CAR broadcasts.
# You invent these; they are NOT your home/router WiFi. Your phone joins
# this network to control the car.
#
# Usage:
#   cp .env.dev .env     # .env is gitignored — put your real values there
#   pio run -d esp32cam-car -t upload    # rebuild + reflash to apply
#
# WPA2 requires the password to be at least 8 characters.
AP_SSID=RC-CAR
AP_PASS=rccar1234
